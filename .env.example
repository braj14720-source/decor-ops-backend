PORT=4000
JWT_SECRET=change-me-to-a-long-random-string
DB_PATH=./data/decorops.db

# Optional — Firebase Cloud Messaging (push notifications).
# If unset, push notifications are silently disabled and the app falls back to local-only.
# Provide EITHER the JSON string OR the path to the file.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
# FIREBASE_SERVICE_ACCOUNT_PATH=/absolute/path/to/service-account.json

# Optional — S3-compatible remote backups.
# BACKUP_S3_BUCKET=my-backup-bucket
# BACKUP_S3_ACCESS_KEY=...
# BACKUP_S3_SECRET_KEY=...
# BACKUP_S3_REGION=ap-south-1
# BACKUP_S3_ENDPOINT=
# BACKUP_S3_PREFIX=backups/